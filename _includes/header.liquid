{% assign current_lang = page.lang | default: 'en' %}
{% assign home_path = '/' %}
{% if current_lang == 'ja' %}{% assign home_path = '/ja/' %}{% endif %}
<header>
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-md fixed-top"
    aria-label="{% if current_lang == 'ja' %}メインメニュー{% else %}Main navigation{% endif %}"
  >
    <div class="container">
      <a class="navbar-brand title" href="{{ home_path | relative_url }}">Wang Zhaorong</a>
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{% if current_lang == 'ja' %}メニューを開閉{% else %}Toggle navigation{% endif %}"
      >
        <span class="icon-bar top-bar"></span><span class="icon-bar middle-bar"></span><span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          {% assign nav_items = site.data.navigation[current_lang] %}
          {% for item in nav_items %}
            <li class="nav-item {% if page.permalink == item.url %}active{% endif %}">
              <a
                class="nav-link"
                href="{{ item.url | relative_url }}"
                {% if page.permalink == item.url %}
                  aria-current="page"
                {% endif %}
              >
                {{- item.title -}}
              </a>
            </li>
          {% endfor %}
          {% if page.translation %}
            <li class="nav-item language-switch">
              <a
                class="nav-link"
                href="{{ page.translation | relative_url }}"
                lang="{% if current_lang == 'ja' %}en{% else %}ja{% endif %}"
                hreflang="{% if current_lang == 'ja' %}en{% else %}ja{% endif %}"
              >
                {%- if current_lang == 'ja' %}EN{% else %}日本語{% endif -%}
              </a>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" title="{% if current_lang == 'ja' %}テーマを変更{% else %}Change theme{% endif %}">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i><i class="fa-solid fa-moon" id="light-toggle-dark"></i
                ><i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
